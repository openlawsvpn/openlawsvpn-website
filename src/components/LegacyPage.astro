---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';

interface Props {
  source: string;
  localize?: boolean;
}

const { source, localize = false } = Astro.props;
const document = await readFile(resolve(process.cwd(), source), 'utf8');
const head = document.match(/<head>([\s\S]*?)<\/head>/i)?.[1];
const bodyMatch = document.match(/<body([^>]*)>([\s\S]*?)<\/body>/i);

if (head === undefined || !bodyMatch) {
  throw new Error(`Unable to render legacy page: ${source}`);
}

const bodyAttributes = bodyMatch[1];
const body = bodyMatch[2];
const bodyClass = bodyAttributes.match(/\bclass=["']([^"']*)["']/i)?.[1];
const lang = document.match(/<html[^>]*\blang=["']([^"']*)["']/i)?.[1] ?? 'en';
const localizationAssets = localize
  ? '\n  <link rel="stylesheet" href="/i18n.css">\n  <script defer src="/i18n.js"></script>'
  : '';
---

<!doctype html>
<html lang={lang}>
  <head set:html={head + localizationAssets}></head>
  <body class={bodyClass} set:html={body}></body>
</html>
